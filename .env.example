NODE_ENV=development
GRAPHQL_PLAYGROUND_ENABLED=true
CORS_ORIGINS=http://localhost:5173

API_GATEWAY_PORT=3000
API_GATEWAY_HOST_PORT=3000

RABBITMQ_USER=healthcare
RABBITMQ_PASSWORD=healthcare-local
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672
RABBITMQ_URL=amqp://healthcare:healthcare-local@127.0.0.1:5672

AUTH_DB_USER=healthcare_auth
AUTH_DB_PASSWORD=change_this_auth_password
AUTH_DB_NAME=healthcare_auth
AUTH_DB_HOST_PORT=5433
AUTH_DATABASE_URL=postgresql://healthcare_auth:change_this_auth_password@auth-postgres:5432/healthcare_auth?schema=public
# Optional host-based development override (Compose keeps using AUTH_DATABASE_URL).
AUTH_DATABASE_URL_LOCAL=postgresql://healthcare_auth:change_this_auth_password@127.0.0.1:5433/healthcare_auth?schema=public

JWT_SECRET=change_this_jwt_secret

SCHEDULE_DB_USER=healthcare_schedule
SCHEDULE_DB_PASSWORD=change_this_schedule_password
SCHEDULE_DB_NAME=healthcare_schedule
SCHEDULE_DB_HOST_PORT=5434
SCHEDULE_DATABASE_URL=postgresql://healthcare_schedule:change_this_schedule_password@schedule-postgres:5432/healthcare_schedule?schema=public
# Optional host-based development override (Compose keeps using SCHEDULE_DATABASE_URL).
SCHEDULE_DATABASE_URL_LOCAL=postgresql://healthcare_schedule:change_this_schedule_password@127.0.0.1:5434/healthcare_schedule?schema=public

REDIS_PASSWORD=change_this_redis_password
REDIS_HOST_PORT=6379
REDISINSIGHT_HOST_PORT=5540
REDIS_URL=redis://:change_this_redis_password@redis:6379
REDIS_URL_LOCAL=redis://:change_this_redis_password@127.0.0.1:6379

AUTH_LOGIN_RATE_LIMIT=5
AUTH_LOGIN_RATE_WINDOW_SECONDS=900
AUTH_REGISTER_RATE_LIMIT=10
AUTH_REGISTER_RATE_WINDOW_SECONDS=3600
QUERY_CACHE_TTL_SECONDS=30

# Local email capture is provided by Mailpit at http://localhost:8025.
SMTP_HOST=mailpit
SMTP_HOST_LOCAL=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Healthcare Schedule <no-reply@healthcare.local>
MAILPIT_WEB_PORT=8025

OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
