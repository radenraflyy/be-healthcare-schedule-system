generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Schedule {
  id          String         @id @default(uuid()) @db.Uuid
  objective   String         @map("Objective")
  customerId  String         @db.Uuid @map("customerID")
  doctorId    String         @db.Uuid @map("doctorID")
  scheduledAt DateTime       @map("scheduleAt")
  status      ScheduleStatus @default(REQUESTED)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  doctor   Doctor   @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  @@index([scheduledAt])
  @@unique([doctorId, scheduledAt])
  @@map("Schedule")
}

model Customer {
  id        String     @id @default(uuid()) @db.Uuid
  name      String
  email     String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  schedules Schedule[]

  @@map("Customer")
}

model Doctor {
  id        String     @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  schedules Schedule[]

  @@map("Doctor")
}

enum ScheduleStatus {
  REQUESTED
  CONFIRMED
  CANCELLED
  COMPLETED
}
