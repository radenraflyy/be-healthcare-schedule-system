{
  "name": "be-healthcare-schedule-system",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build api-gateway",
    "build:auth": "yarn prisma:generate:auth && nest build auth-service",
    "build:schedule": "yarn prisma:generate:schedule && nest build schedule-service",
    "deploy": "nest deploy",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start api-gateway",
    "start:dev": "nest start api-gateway --watch",
    "start:debug": "nest start api-gateway --debug --watch",
    "start:prod": "node dist/apps/api-gateway/main",
    "start:auth": "yarn prisma:generate:auth && nest start auth-service",
    "start:auth:dev": "yarn prisma:generate:auth && nest start auth-service --watch",
    "start:auth:prod": "node dist/apps/auth-service/main",
    "start:schedule": "yarn prisma:generate:schedule && nest start schedule-service",
    "start:schedule:dev": "yarn prisma:generate:schedule && nest start schedule-service --watch",
    "start:schedule:prod": "node dist/apps/schedule-service/main",
    "prisma:generate:auth": "prisma generate --schema apps/auth-service/prisma/schema.prisma",
    "prisma:generate:schedule": "prisma generate --schema apps/schedule-service/prisma/schema.prisma",
    "prisma:generate": "yarn prisma:generate:auth && yarn prisma:generate:schedule",
    "db:migrate:auth": "prisma migrate dev --config apps/auth-service/prisma7.config.ts",
    "db:migrate:schedule": "prisma migrate dev --config apps/schedule-service/prisma7.config.ts",
    "db:studio:auth": "prisma studio --config apps/auth-service/prisma7.config.ts",
    "db:studio:schedule": "prisma studio --config apps/schedule-service/prisma7.config.ts",
    "lint": "oxlint --type-aware apps/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@nestjs/apollo": "^14.1.1",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/graphql": "^14.1.0",
    "@nestjs/microservices": "^12.3.2",
    "@nestjs/observe": "^0.3.0",
    "@nestjs/platform-express": "^12.0.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "graphql": "^16.11.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@rspack/core": "^2.1.10",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "dotenv": "^18.0.9",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "prisma": "7",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2",
    "webpack-node-externals": "^3.0.0"
  }
}
